# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional — SQLite used when unset)
DATABASE_URL=postgresql://user:password@localhost:5432/elggolearn

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# AI — مفتاح من https://aistudio.google.com/apikey (Generative Language API)
GEMINI_API_KEY=your-gemini-api-key
# إن ظهر 404 جرّب: gemini-2.5-flash أو gemini-flash-latest أو gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# اختياري: قائمة احتياط بفواصل تُجرَّب تلقائياً عند 404
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.0-flash,gemini-1.5-flash

# YouTube Data API v3 (search playlists — recommended)
YOUTUBE_API_KEY=your-youtube-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SITE_DOMAIN=127.0.0.1:8001
SITE_NAME=Local Development

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
